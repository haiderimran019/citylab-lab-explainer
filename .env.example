# Copy to .env and fill in. Never commit .env. Every setting is optional.

# gemini | template   (template = no AI; offline explanations, statuses unchanged)
LLM_PROVIDER=gemini
# The model name lives here, never in code.
LLM_MODEL=gemini-3.5-flash-lite
# Leave empty to run fully offline with template text.
LLM_API_KEY=
# Seconds per call (clamped to 2-60).
LLM_TIMEOUT_S=20
# Retries on 429 / 5xx / timeout, with 1 s, 2 s, 4 s backoff plus jitter.
LLM_MAX_RETRIES=3
# Stop retrying before one request gets slower than this many seconds.
LLM_RETRY_BUDGET_S=25
# LLM-backed requests allowed per IP per minute.
RATE_LIMIT_PER_MINUTE=20
# Default: backend/logs/llm_usage.jsonl locally, /tmp/llm_usage.jsonl on Vercel.
# USAGE_LOG_PATH=backend/logs/llm_usage.jsonl
